# --- Web ---
# Public origin. HTTPS required except localhost/127.0.0.1. Use http://localhost:5173 for Vite.
APP_URL=http://localhost:8080
# sqlite:///PATH (local) or postgresql+psycopg://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL=sqlite:///./data/climate.db
# Fernet key. Generate with: uv run python -m climate_control.cli key
ENCRYPTION_KEY=
# Session lifetime in seconds: 300–604800.
SESSION_TTL_SECONDS=86400

# --- Login (configure the admin hash, Google, or both) ---
ADMIN_USERNAME=admin
# Argon2id hash. Generate with: uv run python -m climate_control.cli hash-password
# Keep the hash inside single quotes so Docker Compose preserves its dollar signs.
ADMIN_PASSWORD_HASH=''
# Google login needs the ID, secret, and a comma-separated allowlist together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=

# --- Polling and controls ---
# true | false. Runs the poller and planner inside `serve`; ignored by serve-api.
SCHEDULER_ENABLED=true
# Legacy OIDC endpoint in local combined mode only; unused by serve-api or tick.
SCHEDULER_SERVICE_ACCOUNT=
SCHEDULER_AUDIENCE=
# Seconds, 0–50. Zero keeps provider timeouts; GCP serve-api uses 50.
API_OPERATION_TIMEOUT_SECONDS=0
# Seconds, 60–3600.
POLL_INTERVAL_SECONDS=60
# Seconds between provider requests, ≥ 1.
REQUEST_SPACING_SECONDS=1
# Seconds, ≥ 180.
STALE_AFTER_SECONDS=180

# --- Outdoor air (optional; users choose their station in the app) ---
AQICN_API_TOKEN=
# Seconds, 60–3600.
OUTDOOR_POLL_INTERVAL_SECONDS=300
# Seconds, ≥ 60.
OUTDOOR_STALE_AFTER_SECONDS=10800

# --- Rule planner for agent-managed devices ---
# auto | openrouter | gemini | disabled
#   auto: gemini on Cloud Run with GOOGLE_CLOUD_PROJECT set, else openrouter if keyed, else disabled
#   gemini: Gemini on Agent Platform via Application Default Credentials
AGENT_PROVIDER=auto
# Model ID for the provider. Empty uses ~google/gemini-flash-latest (openrouter)
# or gemini-flash-latest (gemini).
AGENT_MODEL=
OPENROUTER_API_KEY=
# Required for gemini. Location: global or an Agent Platform region.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# embedded | remote. remote queries a planner deployed on Agent Runtime and needs
# AGENT_RUNTIME_RESOURCE=projects/PROJECT/locations/REGION/reasoningEngines/ID
AGENT_RUNTIME=embedded
AGENT_RUNTIME_RESOURCE=
# Model calls per planning job, 1–100.
AGENT_MAX_LLM_CALLS=20
# Seconds per planning job, 30–280 (stays under the 5-minute lease).
AGENT_JOB_TIMEOUT_SECONDS=240
# Seconds one planning pass may keep claiming jobs, 30–1700.
AGENT_TICK_BUDGET_SECONDS=600

# --- Telemetry ---
# auto | gcp | off. auto exports traces and metrics to Google Cloud on Cloud Run.
# Standard OTEL_EXPORTER_OTLP_* variables also enable export.
TELEMETRY=auto

# --- Process ---
# Backend port (serve, serve-api, Compose host binding). Cloud Run sets its own.
PORT=8080
# Vite dev server port; it proxies /api, /auth, and /mcp to PORT.
# For Vite, set APP_URL=http://localhost:FRONTEND_PORT.
FRONTEND_PORT=5173
# true | false. Run migrations when `serve` starts.
AUTO_MIGRATE=false
