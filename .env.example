APP_URL=http://localhost:8080
DATABASE_URL=sqlite:///./data/climate.db
# Generate with: uv run python -m climate_control.cli key
ENCRYPTION_KEY=
ADMIN_USERNAME=admin
# Generate with: uv run python -m climate_control.cli hash-password
# Keep the hash inside single quotes so Docker Compose preserves its dollar signs.
ADMIN_PASSWORD_HASH=''
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=
SCHEDULER_ENABLED=true
# Legacy OIDC endpoint in local combined mode only; unused by serve-api or tick.
SCHEDULER_SERVICE_ACCOUNT=
SCHEDULER_AUDIENCE=
# Zero retains local provider timeouts; GCP serve-api uses 50 seconds.
API_OPERATION_TIMEOUT_SECONDS=0
POLL_INTERVAL_SECONDS=60
REQUEST_SPACING_SECONDS=1
STALE_AFTER_SECONDS=180
# Optional outdoor air monitoring. Users choose their location in the app.
AQICN_API_TOKEN=
OUTDOOR_POLL_INTERVAL_SECONDS=300
OUTDOOR_STALE_AFTER_SECONDS=10800
PORT=8080
AUTO_MIGRATE=false
